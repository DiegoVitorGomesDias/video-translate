{
  "name": "video-translate",
  "description": "Extensão Chrome que transcreve o áudio de um vídeo em inglês e traduz para português em tempo real.",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node --experimental-strip-types --no-warnings --test 'tests/**/*.test.ts'",
    "pwa:dev": "vite --config pwa/vite.config.ts pwa",
    "pwa:build": "vite build --config pwa/vite.config.ts pwa",
    "pwa:compile": "tsc --noEmit -p pwa/tsconfig.json",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1",
    "wxt": "^0.21.5"
  }
}
