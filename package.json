{
  "name": "video-translate",
  "description": "Extensão Chrome que transcreve o áudio de um vídeo em inglês e traduz para português em tempo real.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node --experimental-strip-types --no-warnings --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.0",
    "wxt": "^0.21.5"
  }
}
